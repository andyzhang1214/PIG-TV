<?xml version="1.0" encoding="utf-8"?>
<!--
    首页入口卡（设计稿 .app）：176×188，图标 37 / 名 25 / 副标题 13，三项间距 10
    焦点态整卡变白、文字反黑，由 selector 控制
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/h_app_w"
    android:layout_height="@dimen/h_app_h"
    android:background="@drawable/h_app_bg"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/ico"
        android:layout_width="@dimen/h_app_ico"
        android:layout_height="@dimen/h_app_ico"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/nm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.3mm"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/home_app_nm"
        android:textSize="@dimen/h_app_nm"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6.3mm"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/home_app_sb"
        android:textSize="@dimen/h_app_sb" />

</LinearLayout>
