<?xml version="1.0" encoding="utf-8"?>
<!--
    首页 v8 尺寸表（内容流 + 分类页）

    与 dimens_home.xml 同一套换算规则：mm 是真实物理毫米，基准 55 寸 16:9
    （1217.6mm × 685mm），1 设计 px = 0.634mm。屏幕实际尺寸变了也成立。

    垂直排布（首屏，单位 mm）：
        26 ─ 64   顶栏（导航 + 源胶囊 + 齿轮 + 时钟）
       76 ─ 106   二级菜单（只在「影视」页），与顶栏标签同一条竖轴
      108 ─ 234   hero 信息（标签 / 片名 / 元信息 / 简介）
      注：v13 起顶栏左端那颗账号头像已撤掉，账号入口在设置页最上面。
          这里的 108 保持不动 —— hero 让出的空间已经变成了首屏的呼吸区。
      241 ─ 269   操作按钮
      276 ─ 720   内容流（浏览态整体上移，露出更多行）
-->
<resources>

    <!-- ============ 顶栏 ============ -->
    <!-- 用户 65 寸 3 米看，整条顶栏（左侧导航 + 右侧时间/源）在上一版基础上再放 50% -->
    <dimen name="v8_nav_top">26mm</dimen>
    <dimen name="v8_nav_h">38mm</dimen>
    <dimen name="v8_nav_pad">15mm</dimen>
    <dimen name="v8_nav_gap">6mm</dimen>
    <dimen name="v8_nav_tx">22.8mm</dimen>
    <dimen name="v8_brand_tx">22.8mm</dimen>
    <dimen name="v8_brand_gap">26mm</dimen>
    <dimen name="v8_clock_tx">25.5mm</dimen>
    <dimen name="v8_date_tx">19mm</dimen>
    <!-- 顶栏三组之间那条 1mm 竖线（内容类 | 工具类） -->
    <dimen name="v8_nav_sep_h">25mm</dimen>
    <dimen name="v8_nav_sep_gap">7.5mm</dimen>

    <!-- ============ 二级菜单（影视 → 电影/电视剧/…） ============ -->
    <!-- 只在「影视」页出现，位置在顶栏正下方。字号比顶栏小一档（22.8 → 17），
         层级上「影视」是父级，二级项不该和它一样大。 -->
    <dimen name="v8_subnav_top">12mm</dimen>
    <dimen name="v8_subnav_h">30mm</dimen>
    <dimen name="v8_subnav_pad">14mm</dimen>
    <dimen name="v8_subnav_gap">5mm</dimen>
    <dimen name="v8_subnav_tx">17mm</dimen>
    <!-- 二级菜单占掉的垂直高度：影视页的 hero、按钮、海报墙都要整体下移这么多，
         否则会压在二级菜单上（顶栏 26+38 到底 = 64mm，二级菜单 72~102mm，
         而 hero 原本就从 72mm 起）。 -->
    <dimen name="v8_subnav_shift">38mm</dimen>

    <!-- ============ 右侧胶囊（源 / 齿轮） ============ -->
    <dimen name="v8_pill_h">48mm</dimen>
    <dimen name="v8_pill_pad">14mm</dimen>
    <dimen name="v8_pill_gap">8mm</dimen>
    <dimen name="v8_pill_tx">21.5mm</dimen>
    <dimen name="v8_pill_ico">21.5mm</dimen>
    <dimen name="v8_pill_dot">8.5mm</dimen>
    <dimen name="v8_pill_radius">24mm</dimen>

    <!-- ============ hero 信息 ============ -->
    <!-- 108mm：hero 整块从头像那一列下面起。头像字形现在只到 87mm（56mm 的位居中在
         38~94），理论上 96 就够，但 hero 的 tag 行是从版心最左开始铺的，
         贴着字形下沿会显得挤；108 是上一版为了避开 72mm 圆盘定的数，
         现在圆盘没了、保留它当呼吸位，改小反而会让 hero 顶到二级菜单的视觉重心里。 -->
    <dimen name="v8_hero_top">108mm</dimen>
    <dimen name="v8_hero_w">560mm</dimen>
    <!-- 65 寸 3 米外：顶栏已经放大到 22.8mm，hero 这几行原来停在 9~11mm，
         放一起头重脚轻，整体提到 13~15mm -->
    <dimen name="v8_hero_tag">13mm</dimen>
    <dimen name="v8_hero_tag_dot">5mm</dimen>
    <!-- 片名：这里只是布局时的初始值，运行时由 HomeActivity.applyHeroTitleSize()
         按「字数档位 + 实际文字宽度」重算，不再依赖这个数。
         改它只影响首帧那一瞬间的字号，别当成最终大小。
         实测 1080p 上 1mm ≈ 1.5px（AutoSize 的 mm 是设计稿口径，不是物理毫米）。 -->
    <dimen name="v8_hero_title">42mm</dimen>
    <dimen name="v8_hero_title_mt">7mm</dimen>
    <dimen name="v8_hero_meta">15mm</dimen>
    <dimen name="v8_hero_meta_mt">6mm</dimen>
    <dimen name="v8_hero_desc">13.5mm</dimen>
    <dimen name="v8_hero_desc_mt">6.3mm</dimen>
    <dimen name="v8_hero_lift">-58mm</dimen>

    <!-- ============ 操作按钮 ============ -->
    <!-- 字号涨上来之后按钮得跟着长，否则文字顶着上下边框；
         跟着 hero 一起下移（hero_top 72→108，这里 205→241），两者间距保持不变 -->
    <dimen name="v8_btn_top">241mm</dimen>
    <dimen name="v8_btn_h">28mm</dimen>
    <dimen name="v8_btn_pad">18mm</dimen>
    <dimen name="v8_btn_tx">14mm</dimen>
    <dimen name="v8_btn_gap">8mm</dimen>
    <dimen name="v8_btn_radius">14mm</dimen>

    <!-- ============ 内容流 ============ -->
    <!-- 首屏墙起点，跟 HomeActivity.MM_LINE_TOP_FIRST 必须一致：
         hero 让到 108 → 按钮 241~269 → 墙 276。
         影视页不吃这个值（那一页走 MM_WALL_TOP_CAT=118），这里只影响第一帧。 -->
    <dimen name="v8_lines_top">276mm</dimen>
    <dimen name="v8_lines_lift">96mm</dimen>
    <dimen name="v8_line_head">19mm</dimen>
    <dimen name="v8_line_sub">16mm</dimen>
    <dimen name="v8_line_head_mb">7.6mm</dimen>
    <dimen name="v8_line_gap">16mm</dimen>
    <dimen name="v8_line_pad_end">45.6mm</dimen>
    <dimen name="v8_line_body_h">240mm</dimen>

    <!-- 行内海报：196 × 294 设计 px => 124 × 186 mm（2:3） -->
    <dimen name="v8_card_w">146mm</dimen>
    <dimen name="v8_card_h">219mm</dimen>
    <dimen name="v8_card_gap">13mm</dimen>
    <dimen name="v8_card_name">17mm</dimen>
    <dimen name="v8_card_name_mt">6mm</dimen>
    <dimen name="v8_card_radius">6.3mm</dimen>
    <dimen name="v8_card_badge">8.2mm</dimen>

    <!-- ============ 分类页 ============ -->
    <dimen name="v8_cat_w">170mm</dimen>
    <dimen name="v8_cat_item_h">26mm</dimen>
    <dimen name="v8_cat_tx">11.4mm</dimen>
    <dimen name="v8_cat_cnt">8.9mm</dimen>
    <dimen name="v8_cat_pad">9mm</dimen>
    <dimen name="v8_cat_top">86mm</dimen>
    <dimen name="v8_chip_h">25mm</dimen>
    <dimen name="v8_chip_pad">14mm</dimen>
    <dimen name="v8_chip_tx">13mm</dimen>
    <dimen name="v8_cat_title">16.5mm</dimen>
    <dimen name="v8_grid_w">132mm</dimen>
    <dimen name="v8_grid_h">198mm</dimen>

    <!-- ============ 配置中心左侧分组 ============ -->
    <!-- 单独一套，不复用 v8_cat_*（那套是分类页的，一行行挤在一起，不能随便放大）。
         配置中心左侧只有 4 项、下面全是空的，11.4mm（1080p 上约 17px）在 3 米外
         基本只是一条灰线，用户原话「看都看不见」。这里按顶栏的 2/3 取 17mm，
         行高跟着放到 34mm，让 4 项之间拉开距离、不糊成一片。 -->
    <dimen name="v8_set_tx">19mm</dimen>
    <dimen name="v8_set_item_h">38mm</dimen>
    <dimen name="v8_set_pad">14mm</dimen>
    <dimen name="v8_set_w">182mm</dimen>
    <!-- 页标题必须比左列大一档，否则「配置中心」和下面 4 个分组看起来是同级 -->
    <dimen name="v8_set_title">23mm</dimen>

    <!-- ============ 首页顶部：推荐大卡行 ============ -->
    <!-- 首页只有「推荐」一块，卡片做大到把首屏填满，横向可滑看全部：
         卡宽 215mm + 间距 12mm，一屏正好 5 张；卡高 322mm 是 2:3，海报不裁。
         改宽度要同步 v8_wall_h（卡高 + 片名行）。 -->
    <dimen name="v8_wall_h">358mm</dimen>
    <dimen name="v8_wall_card_w">215mm</dimen>
    <dimen name="v8_wall_card_h">322mm</dimen>
    <dimen name="v8_wall_gap">12mm</dimen>
    <dimen name="v8_wall_name">19mm</dimen>
    <dimen name="v8_wall_name_mt">4.6mm</dimen>
    <dimen name="v8_wall_sub">15mm</dimen>

    <!-- ============ 筛选弹层（影视页 → 按 OK 打开） ============ -->
    <!-- 面板左右各留 150mm、上下各留 70mm：1080p 上正好 938 × 545mm，
         一屏能同时看到 5~6 组筛选（年份/地区/类型/排序/语言），不用滚。 -->
    <dimen name="v8_flt_margin_h">150mm</dimen>
    <dimen name="v8_flt_margin_v">70mm</dimen>
    <dimen name="v8_flt_title">20mm</dimen>
    <dimen name="v8_flt_group_name">15mm</dimen>
    <dimen name="v8_flt_group_w">78mm</dimen>
    <dimen name="v8_flt_pill_h">19mm</dimen>
    <dimen name="v8_flt_pill_tx">14.5mm</dimen>
    <dimen name="v8_flt_pill_pad">9mm</dimen>
    <dimen name="v8_flt_row_gap">9mm</dimen>
    <dimen name="v8_flt_btn_h">19mm</dimen>

    <!-- 底部按键提示：原来 14mm，跟放大的顶栏放一起像脚注，提到 17mm -->
    <dimen name="v8_hint_tx">17mm</dimen>

    <!-- ============ 会员中心（v12） ============ -->
    <!-- 1080p 电视上 1mm ≈ 0.9px；3 米视距下正文字号 ≈ 18mm、主标题 40mm。
         这一页没有「占剩余」的横向张力，所有间距都按固定值排，改一处即可整体缩放。 -->
    <dimen name="v8_vip_pad">70mm</dimen>
    <dimen name="v8_vip_radius">20mm</dimen>
    <!-- 两栏之间的横向间隙（左栏会员卡 / 右栏登录区） -->
    <dimen name="v8_vip_col_gap">40mm</dimen>
    <dimen name="v8_vip_title">40mm</dimen>
    <dimen name="v8_vip_card_pad">40mm</dimen>
    <dimen name="v8_vip_avatar">120mm</dimen>
    <!-- 会员卡头像里的 logo / 首字共用这一块位置；120 - 48 = 72，四边各留 24mm 金边。
         线稿本身已经铺满画布（见 drawable/v8_mine_pig.xml 的 1.4286 缩放），
         所以 72 就是画出来的猪头高度，跟改版前 88×70% ≈ 62 相比略微放大。 -->
    <dimen name="v8_vip_logo">62mm</dimen>
    <dimen name="v8_vip_name">30mm</dimen>
    <dimen name="v8_vip_sub">18mm</dimen>
    <dimen name="v8_vip_body">22mm</dimen>
    <dimen name="v8_vip_code_h">88mm</dimen>
    <!-- 扫码登录的二维码边长；3 米外不用扫，是给手机扫的，170mm 够大 -->
    <dimen name="v8_vip_qr">170mm</dimen>
    <!-- 数字码是这一页唯一需要「隔两米也读得出」的元素，字号单独给到 82mm -->
    <dimen name="v8_vip_code_tx">54mm</dimen>
    <dimen name="v8_vip_btn_h">56mm</dimen>
    <dimen name="v8_vip_btn_pad">44mm</dimen>
    <dimen name="v8_vip_btn_tx">20mm</dimen>

    <!-- 设置页「我的」：卡片右侧那两个数字（登录设备 / 可绑上限）。
         比正文大一号，3 米外一眼能读出 2 还是 5。 -->
    <dimen name="v8_vip_num">26mm</dimen>

    <!-- 设置页「我的」的卡片：这一页只是整屏的 2/3 宽，用会员中心那套
         120mm 头像 + 40mm 内边距会占掉五分之一的屏高，卡像一堵墙。
         单独一套小一号的，只在这一页用。 -->
    <dimen name="v8_me_avatar">88mm</dimen>
    <dimen name="v8_me_logo">46mm</dimen>
    <dimen name="v8_me_card_pad">26mm</dimen>

</resources>
