<?xml version="1.0" encoding="utf-8"?>
<!-- 首页一行内容：行头（标题 + 副标）+ 横向卡片列表
     行容器由 HomeActivity 动态添加，这个布局只是一行的模板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/h_edge"
        android:layout_marginBottom="@dimen/v8_line_head_mb"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#F2FFFFFF"
            android:textSize="@dimen/v8_line_head"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLineSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7.6mm"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#66FFFFFF"
            android:textSize="@dimen/ts_14" />

    </LinearLayout>

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/rvLine"
        android:layout_width="match_parent"
        android:layout_height="@dimen/v8_line_body_h"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/h_edge"
        android:paddingEnd="@dimen/v8_line_pad_end"
        app:tv_selectedItemIsCentered="false" />

</LinearLayout>
