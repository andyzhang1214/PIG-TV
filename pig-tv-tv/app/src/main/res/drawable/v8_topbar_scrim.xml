<?xml version="1.0" encoding="utf-8"?>
<!-- 二级页面顶栏的压暗层
     直播页的画面是满屏视频，白字导航直接压在画面上任何一幕都会糊。
     这里从顶部 #E60B0A0C 渐到全透明，只压顶栏那一条，不碰画面其余部分。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#000B0A0C"
        android:startColor="#E60B0A0C"
        android:type="linear" />
</shape>
