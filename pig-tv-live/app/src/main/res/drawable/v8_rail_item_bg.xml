<?xml version="1.0" encoding="utf-8"?>
<!--
    左栏行（全部 / 收藏 / 超清专区 / 各分组）的三态。

    和顶部那排胶囊的区别只有形状：胶囊是圆角等于高度的「药丸」，左栏是
    16px 圆角的长条（设计稿 .ri 的 border-radius: 16px），一行行排下来像目录。

      focused  → uiSurfaceFocus + uiStrokeFocus（遥控器光标所在行，最亮）
      selected → uiSurfaceSel + uiStroke（当前在看的那一档）
      默认     → 透明：左栏本身是一整块面板，每行再铺一层底色就脏了
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/uiSurfaceFocus" />
            <stroke
                android:width="1.6mm"
                android:color="?attr/uiStrokeFocus" />
            <corners android:radius="@dimen/v8_rail_item_radius" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/uiSurfaceSel" />
            <stroke
                android:width="0.9mm"
                android:color="?attr/uiStroke" />
            <corners android:radius="@dimen/v8_rail_item_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/v8_rail_item_radius" />
        </shape>
    </item>
</selector>
