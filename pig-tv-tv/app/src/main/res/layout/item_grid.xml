<?xml version="1.0" encoding="utf-8"?>
<!-- 分类略缩图 · 与首页推荐卡同一套 Apple TV 风排版：
     轻角标 + 渐变遮罩 + 轻字排版。
     id 保持与旧版一致（tvYear/tvArea/tvLang/tvNote/tvName/tvActor/ivThumb），
     GridAdapter 无需感知布局变化。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_thumb_radius"
    android:focusable="true"
    android:padding="@dimen/vs_1">

    <FrameLayout
        android:layout_width="@dimen/vs_214"
        android:layout_height="@dimen/vs_280">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/PosterRound" />

        <!-- 左上角标：年份/地区/语言，小号轻底 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_6"
            android:layout_marginTop="@dimen/vs_6"
            android:layout_marginRight="@dimen/vs_6"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vs_3"
                android:layout_marginRight="@dimen/vs_3"
                android:background="@drawable/shape_badge_small"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_4"
                android:paddingRight="@dimen/vs_4"
                android:paddingTop="@dimen/vs_1"
                android:paddingBottom="@dimen/vs_1"
                android:singleLine="true"
                android:textColor="#E6FFFFFF"
                android:textSize="@dimen/ts_16" />

            <TextView
                android:id="@+id/tvArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vs_3"
                android:layout_marginRight="@dimen/vs_3"
                android:background="@drawable/shape_badge_small"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_4"
                android:paddingRight="@dimen/vs_4"
                android:paddingTop="@dimen/vs_1"
                android:paddingBottom="@dimen/vs_1"
                android:singleLine="true"
                android:textColor="#E6FFFFFF"
                android:textSize="@dimen/ts_16" />

            <TextView
                android:id="@+id/tvLang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_badge_small"
                android:ellipsize="end"
                android:gravity="center"
                android:paddingLeft="@dimen/vs_4"
                android:paddingRight="@dimen/vs_4"
                android:paddingTop="@dimen/vs_1"
                android:paddingBottom="@dimen/vs_1"
                android:singleLine="true"
                android:textColor="#E6FFFFFF"
                android:textSize="@dimen/ts_16" />

        </LinearLayout>

        <!-- 底部渐变遮罩 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_70"
            android:layout_gravity="bottom"
            android:background="@drawable/shape_thumb_bottom_scrim" />

        <!-- 底部文字：备注小字 + 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_6"
            android:paddingRight="@dimen/vs_6"
            android:paddingBottom="@dimen/vs_6">

            <TextView
                android:id="@+id/tvNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_2"
                android:ellipsize="end"
                android:gravity="start"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/ts_16"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:shadowColor="@color/color_000000_90"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="3"
                android:singleLine="true"
                android:text="Title"
                android:textColor="@android:color/white"
                android:textSize="@dimen/ts_20" />

            <TextView
                android:id="@+id/tvActor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="start"
                android:paddingTop="@dimen/vs_1"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="@dimen/ts_14"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/delFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_user_delete"
            android:layout_gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/vs_80"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/vs_20"
                android:src="@drawable/icon_delete" />
        </FrameLayout>

    </FrameLayout>
</FrameLayout>
