<?xml version="1.0" encoding="utf-8"?>
<!-- 全局加载态：一条细白弧 + 一行低对比度小字。
     不做进度条（拿不到真实进度，假进度更骗人），只用「在动」告诉用户没死。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ProgressBar
            android:layout_width="46mm"
            android:layout_height="46mm"
            android:indeterminateBehavior="repeat"
            android:indeterminateDrawable="@drawable/anim_v8_loading"
            android:indeterminateOnly="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12mm"
            android:includeFontPadding="false"
            android:letterSpacing="0.16"
            android:text="正在加载"
            android:textColor="#73FFFFFF"
            android:textSize="@dimen/ts_14" />

    </LinearLayout>

</FrameLayout>
