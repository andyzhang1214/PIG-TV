<?xml version="1.0" encoding="utf-8"?>
<!--
    直播页

    外层 live_page_root 是给 v8 顶栏留的位置，不能挪进 live_root 里：
    live_root 会被 LoadSir 整个接管（空态/加载态直接把 live_root 隐藏掉），
    顶栏要是挂在它里面，源站没频道的时候顶栏也跟着消失，
    用户就又只剩「按返回」一条路 —— 也就是说必须放在 LoadSir 管辖范围之外。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_page_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0A0C">

<FrameLayout
    android:id="@+id/live_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_horizontal"
    android:layout_margin="0dp"
    android:orientation="horizontal"
    android:padding="0dp">

    <xyz.doikki.videoplayer.player.VideoView
        android:id="@+id/mVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tv_selected_channel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="25dp"
        android:layout_marginRight="40dp"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:focusable="false"
        android:shadowColor="@color/color_000000_80"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="1"
        android:textColor="@android:color/white"
        android:textSize="96sp"
        android:textStyle="bold"
        android:visibility="gone" />

        <!--
        切换频道面板（深色玻璃，压在画面上）

        结构照观众熟悉的直播客户端来：左边一列分组、右边一列频道、顶上牌子、
        底下一行按键提示。原来的三块用 1dp 竖线隔开，视觉上是三个独立盒子；
        现在收进一块整体圆角面板里，只用留白和字号分栏，画面仍然从面板右侧露出来。

        面板宽度 = 14 + 140 + 6 + 296 + 22 + 14 ≈ 492mm（55 寸屏约 40%），
        剩下的画面始终可见 —— 用户是在「边看边挑台」，不是在填表。
    -->
    <LinearLayout
        android:id="@+id/tvLeftChannelListLayout"
        android:layout_width="@dimen/v8_live_panel_w"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/vs_20"
        android:layout_marginTop="@dimen/vs_60"
        android:layout_marginEnd="@dimen/vs_20"
        android:layout_marginBottom="@dimen/vs_20"
        android:background="@drawable/bg_live_panel"
        android:baselineAligned="false"
        android:orientation="vertical"
        android:padding="@dimen/v8_live_panel_pad">

        <!-- 牌子：应用图标 + PLIVE，右侧当前分组的台数。
             台数放在这里而不是标题里，是因为它跟着分组变，
             换分组时数字在同一个位置变化，比重新读一遍标题快。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/v8_live_brand_icon"
                android:layout_height="@dimen/v8_live_brand_icon"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/app_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8mm"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="@string/app_name"
                android:textColor="@color/v8_live_row_tx"
                android:textSize="@dimen/v8_live_brand_tx"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPanelCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/v8_live_row_sub"
                android:textSize="@dimen/v8_live_grp_num_tx" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.6mm"
            android:layout_marginTop="10mm"
            android:layout_marginBottom="8mm"
            android:background="@color/v8_live_panel_stroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <!-- 左列：分组。不画台标、不画图标，只有名字和台数 —— 分组本身就是个筛子，
                 给它配图标只会让这一列看起来比右边频道列更重要。 -->
            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGroupGridView"
                android:layout_width="@dimen/v8_live_panel_grp_w"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:divider="@null"
                android:fadeScrollbars="false"
                android:paddingTop="2mm"
                android:paddingBottom="2mm"
                android:scrollbars="none"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="2mm" />

            <!-- 左列与右列之间的「更多节目」入口（老逻辑，平时 GONE） -->
            <LinearLayout
                android:id="@+id/mDivLeft"
                android:layout_width="@dimen/v8_live_div_w"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_live_group_row"
                android:clickable="true"
                android:focusable="true"
                android:onClick="divLoadEpgL"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_15"
                android:paddingBottom="@dimen/vs_15"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_arrow0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingBottom="5dp"
                    android:text="@string/v8_live_panel_epg"
                    android:textColor="@color/v8_live_row_sub"
                    android:textSize="@dimen/v8_live_badge_tx" />

                <ImageView
                    android:id="@+id/iv_arrow2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/vs_4"
                    android:src="@drawable/scrollviewleft" />

                <TextView
                    android:id="@+id/tv_arrow3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:paddingTop="5dp"
                    android:text="@string/v8_live_panel_info"
                    android:textColor="@color/v8_live_row_sub"
                    android:textSize="@dimen/v8_live_badge_tx" />
            </LinearLayout>

            <!-- 右列：频道行（台标 + 台名 + 线路数 + 正在播徽标） -->
            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mChannelGridView"
                android:layout_width="@dimen/v8_live_panel_ch_w"
                android:layout_height="match_parent"
                android:layout_marginStart="6mm"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:divider="@null"
                android:fadeScrollbars="false"
                android:focusable="true"
                android:paddingTop="2mm"
                android:paddingBottom="2mm"
                android:scrollbars="none"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="2mm" />

            <!-- 「节目 / 信息」竖条：按右键从频道行过来，展开 EPG。
                 高度只占中段一小块（不是撑满）—— 撑满时「节目」贴顶、「信息」贴底，
                 两字隔了半屏，看着像两条不相干的浮字；这是一枚页签，不是分栏边。 -->
            <LinearLayout
                android:id="@+id/mDivRight"
                android:layout_width="@dimen/v8_live_div_w"
                android:layout_height="@dimen/v8_live_div_h"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4mm"
                android:background="@drawable/bg_live_group_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:onClick="divLoadEpgR"
                android:orientation="vertical"
                android:paddingTop="@dimen/vs_15"
                android:paddingBottom="@dimen/vs_15">

                <TextView
                    android:id="@+id/tv_arrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/v8_live_panel_epg"
                    android:textColor="@color/v8_live_row_sub"
                    android:textSize="@dimen/v8_live_badge_tx" />

                <ImageView
                    android:id="@+id/iv_arrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="@dimen/vs_4"
                    android:src="@drawable/scrollviewright" />

                <TextView
                    android:id="@+id/tv_arrow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/v8_live_panel_info"
                    android:textColor="@color/v8_live_row_sub"
                    android:textSize="@dimen/v8_live_badge_tx" />
            </LinearLayout>

            <!-- EPG：展开时频道列和分组列都收起，整块面板宽度都给它，
                 否则 460dp 的日期列 + 节目单会盖在频道行上面（实测就是这个叠法）。 -->
            <LinearLayout
                android:id="@+id/mGroupEPG"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/mEpgDateGridView"
                    android:layout_width="@dimen/vs_120"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/vs_10"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:layout_marginTop="@dimen/vs_10"
                    android:layout_marginBottom="@dimen/vs_10"
                    android:divider="@null"
                    android:fadeScrollbars="false"
                    android:focusable="true"
                    android:paddingLeft="@dimen/vs_5"
                    android:paddingTop="@dimen/vs_5"
                    android:paddingBottom="@dimen/vs_5"
                    android:textColor="@color/color_FFFFFF"
                    app:tv_selectedItemIsCentered="true"
                    app:tv_verticalSpacingWithMargins="10mm" />

                <!-- 节目单：0dp + weight，别用 match_parent ——
                     横向 LinearLayout 里 match_parent 会把后面的占位文字挤出屏幕，
                     「正在加载节目单…」就永远看不见。 -->
                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/mEpgInfoGridView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/vs_10"
                    android:layout_weight="1"
                    android:divider="@null"
                    android:fadeScrollbars="false"
                    android:focusable="true"
                    android:padding="@dimen/vs_5"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/txtNoEpg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingEnd="10mm"
                    android:text="@string/v8_epg_none"
                    android:textColor="@color/v8_live_row_sub"
                    android:textSize="@dimen/v8_live_row_sub_tx"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- 按键提示：只写真的能用的键，不写「长按收藏」这类播放页没实现的 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10mm"
            android:includeFontPadding="false"
            android:text="@string/v8_live_hint_nav"
            android:textColor="#8C93A6"
            android:textSize="@dimen/v8_live_hint_tx" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3mm"
            android:includeFontPadding="false"
            android:text="@string/v8_live_hint_back"
            android:textColor="#6E7688"
            android:textSize="@dimen/v8_live_hint_tx" />

    </LinearLayout>

<LinearLayout
        android:id="@+id/tvRightSettingLayout"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:layout_margin="@dimen/vs_20"
        android:background="@drawable/bg_live"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mSettingItemView"
            android:layout_width="@dimen/vs_160"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/vs_15"
            android:visibility="visible"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="10mm" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:background="@color/color_3D3D3D" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mSettingGroupView"
            android:layout_width="@dimen/vs_180"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="@dimen/vs_15"
            android:visibility="visible"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="10mm" />
    </LinearLayout>

    <!--频道序号显示-->
    <LinearLayout
        android:id="@+id/tvBottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/shape_live_bg_bottom"
        android:gravity="bottom"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/tv_logo"
            android:layout_width="@dimen/vs_400"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/vs_60"
            android:layout_marginLeft="@dimen/vs_60"
            android:layout_marginTop="@dimen/vs_30"
            android:layout_marginEnd="@dimen/vs_30"
            android:layout_marginRight="@dimen/vs_30"
            android:layout_marginBottom="@dimen/vs_30"
            android:layout_weight="1"
            android:paddingTop="@dimen/vs_10"
            android:paddingBottom="@dimen/vs_10"
            app:srcCompat="@drawable/img_logo_placeholder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="@dimen/vs_30"
            android:paddingBottom="@dimen/vs_30">

            <LinearLayout
                android:id="@+id/ll_line1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/vs_10">

                <View
                    android:id="@+id/redLine"
                    android:layout_width="@dimen/vs_6"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/vs_20"
                    android:layout_marginLeft="@dimen/vs_20"
                    android:layout_marginTop="@dimen/vs_5"
                    android:layout_marginBottom="@dimen/vs_5"
                    android:background="?attr/color_theme" />

                <TextView
                    android:id="@+id/tv_current_program_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|left"
                    android:layout_weight="0"
                    android:layout_marginRight="@dimen/vs_20"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="left"
                    android:paddingLeft="@dimen/vs_20"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:singleLine="true"
                    android:text="00:00 - 23:59"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_36"
                    android:textStyle="normal"
                    android:visibility="visible" />

                <com.pigtv.ui.tv.widget.MarqueeTextView
                    android:id="@+id/tv_current_program_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|left"
                    android:layout_weight="5"
                    android:ellipsize="marquee"
                    android:fontFamily="sans-serif"
                    android:gravity="left"
                    android:paddingRight="@dimen/vs_20"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:singleLine="true"
                    android:text="No information"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_36"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sys_time"
                    android:layout_width="@dimen/vs_240"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|right"
                    android:fontFamily="sans-serif"
                    android:gravity="right"
                    android:maxLines="1"
                    android:paddingRight="@dimen/vs_60"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:text="00:00 AM"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_36"
                    android:textStyle="normal"
                    android:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_line2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/vs_5">

                <TextView
                    android:id="@+id/tv_channel_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center"
                    android:layout_marginStart="@dimen/vs_20"
                    android:layout_marginEnd="@dimen/vs_20"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:background="@drawable/channel_num_bg"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_8"
                    android:paddingTop="@dimen/vs_5"
                    android:paddingRight="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_5"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="5"
                    android:text="1"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_15"
                    android:textStyle="bold"
                    android:visibility="visible" />

                <com.pigtv.ui.tv.widget.MarqueeTextView
                    android:id="@+id/tv_channel_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center"
                    android:layout_marginEnd="@dimen/vs_20"
                    android:layout_marginRight="@dimen/vs_20"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:background="@drawable/channel_num_bg"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_8"
                    android:paddingTop="@dimen/vs_5"
                    android:paddingRight="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_5"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="5"
                    android:text="Channel 1"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_15"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center"
                    android:layout_marginEnd="@dimen/vs_20"
                    android:layout_marginRight="@dimen/vs_20"
                    android:layout_weight="1"
                    android:background="@drawable/channel_num_bg"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_8"
                    android:paddingTop="@dimen/vs_5"
                    android:paddingRight="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_5"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="2"
                    android:text="1920 x 1080"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_15"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_source"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center"
                    android:layout_weight="1"
                    android:background="@drawable/channel_num_bg"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:paddingLeft="@dimen/vs_8"
                    android:paddingTop="@dimen/vs_5"
                    android:paddingRight="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_5"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="2"
                    android:text="源 1/1"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_15"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_line3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/vs_5">

                <TextView
                    android:id="@+id/tv_next_program_time"
                    android:layout_width="@dimen/vs_160"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="left"
                    android:paddingLeft="@dimen/vs_20"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:singleLine="true"
                    android:text="00:00 - 23:59"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_20"
                    android:textStyle="normal"
                    android:visibility="visible" />

                <com.pigtv.ui.tv.widget.MarqueeTextView
                    android:id="@+id/tv_next_program_name"
                    android:layout_width="@dimen/vs_440"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|left"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="left"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:paddingLeft="@dimen/vs_20"
                    android:paddingRight="@dimen/vs_20"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:singleLine="true"
                    android:text="No information"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_20"
                    android:textStyle="normal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/vs_5"
                android:visibility="gone">

                <TextView
                    android:id="@+id/curr_time"
                    android:layout_width="@dimen/vs_20_"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center_vertical"
                    android:paddingLeft="@dimen/vs_20"
                    android:paddingEnd="@dimen/vs_10"
                    android:paddingRight="@dimen/vs_20"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:text="00:00:00"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_18" />

                <TextView
                    android:layout_width="10dp"
                    android:layout_height="wrap_content" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_vertical"
                    android:layout_weight="1"
                    android:background="@null"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:max="1000"
                    android:maxHeight="@dimen/vs_2"
                    android:minHeight="@dimen/vs_2"
                    android:padding="@dimen/vs_1"
                    android:paddingStart="@dimen/vs_0"
                    android:paddingEnd="@dimen/vs_0"
                    android:progressDrawable="@drawable/shape_player_control_vod_seek"
                    android:thumb="@drawable/shape_player_control_vod_seek_thumb"
                    android:thumbOffset="@dimen/vs_0" />

                <TextView
                    android:layout_width="10dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/total_time"
                    android:layout_width="@dimen/vs_20_"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/vs_10"
                    android:paddingLeft="@dimen/vs_20"
                    android:paddingRight="@dimen/vs_60"
                    android:shadowColor="@color/color_FF000000"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:text="00:00:00"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_18" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!--时间显示-->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:layout_marginTop="@dimen/vs_5"
        android:layout_marginEnd="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_10"
        android:gravity="center"
        android:shadowColor="@color/color_FF000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2"
        android:text="00:00 PM"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_22"
        android:textStyle="bold"
        android:visibility="gone" />
    <!--右下角网速显示-->
    <TextView
        android:id="@+id/tvNetSpeed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginEnd="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_10"
        android:layout_marginBottom="@dimen/vs_5"
        android:gravity="center"
        android:shadowColor="@color/color_FF000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2"
        android:text="0.00 MB/s"
        android:textColor="@color/color_FFFFFF"
        android:textSize="@dimen/ts_22"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tvBackButton"
        android:layout_width="@dimen/vs_60"
        android:layout_height="@dimen/vs_60"
        android:layout_gravity="center|right"
        android:layout_marginStart="@dimen/vs_50"
        android:layout_marginLeft="@dimen/vs_50"
        android:layout_marginEnd="@dimen/vs_50"
        android:layout_marginRight="@dimen/vs_50"
        android:background="@drawable/button_dialog_vod"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/vs_40"
            android:layout_height="@dimen/vs_40"
            android:layout_gravity="center"
            android:src="@drawable/v_back" />
    </LinearLayout>

</FrameLayout>

    <!-- ============ v8 顶栏 ============ -->
    <!-- 和首页 / 收藏 / 历史 / 搜索同一套：一排标签 + 右侧时钟。
         选台态和空态都在，左右一按就能切到别的标签，不用退回首页再点。
         焦点落到哪一格就直接切过去（focusSwitch），跟首页手感一致。 -->
    <LinearLayout
        android:id="@+id/liveTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/v8_topbar_scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/h_edge"
        android:paddingTop="@dimen/v8_nav_top"
        android:paddingEnd="@dimen/h_edge"
        android:paddingBottom="16mm"
        android:visibility="gone">

        <!-- 这一行的高度不能写死 38mm：右边是「时间 + 日期」两行（25.5 + 1.9 + 19 ≈ 47mm），
             写死就会把日期裁成一条上边缘（实测右上角只剩「11月18日 周…」的字头）。
             标签条自己的高度由 liveNavBox 的 v8_nav_h 撑着，这里交给 wrap_content 取最大值。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/liveNavBox"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/v8_nav_h"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/liveTopTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/v8_clock_tx" />

                <TextView
                    android:id="@+id/liveTopDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1.9mm"
                    android:includeFontPadding="false"
                    android:textColor="#80FFFFFF"
                    android:textSize="@dimen/v8_date_tx" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
