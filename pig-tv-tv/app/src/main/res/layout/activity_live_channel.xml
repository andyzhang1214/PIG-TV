<?xml version="1.0" encoding="utf-8"?>
<!--
    直播频道表（点「直播」先进的那一页）

    和手机端「直播」页对齐：进来先看见全部频道，挑一个才进播放器。
    以前点「直播」是直接进 LivePlayActivity 播上次那个台 —— 那个台经常已经失效，
    屏幕上就是一片黑，还得先按 MENU 调出左侧列表才知道有哪些台，等于什么都没给。

    顶上那排是分组胶囊，第一项固定「全部」。胶囊用 TvRecyclerView + 横向
    LinearLayoutManager（和筛选弹层同一套），焦点走到哪格就自动滚到哪格。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0A0C"
    android:orientation="vertical">

    <!-- ================= v8 顶栏 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/h_edge"
        android:paddingTop="@dimen/v8_nav_top"
        android:paddingEnd="@dimen/h_edge">

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/v8_nav_h"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:text="@string/app_name"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/v8_brand_tx"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/navBox"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/v8_nav_h"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14mm"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="#FFFFFFFF"
                android:textSize="@dimen/v8_clock_tx" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.9mm"
                android:includeFontPadding="false"
                android:textColor="#80FFFFFF"
                android:textSize="@dimen/v8_date_tx" />

        </LinearLayout>

    </LinearLayout>

    <!-- ================= 标题行：直播 · N 个频道 · M 个分组 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8mm"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/h_edge"
        android:paddingEnd="@dimen/h_edge">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/v8_live_title"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/v8_live_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLiveStat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12mm"
            android:includeFontPadding="false"
            android:textColor="#8CFFFFFF"
            android:textSize="@dimen/v8_live_stat" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/v8_live_hint"
            android:textColor="#5CFFFFFF"
            android:textSize="@dimen/v8_live_stat" />

    </LinearLayout>

    <!-- ================= 分组胶囊：全部 / CCTV / 卫视 … ================= -->
    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/mChipRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10mm"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/h_edge"
        android:paddingTop="2mm"
        android:paddingEnd="@dimen/h_edge"
        android:paddingBottom="2mm"
        app:tv_horizontalSpacingWithMargins="@dimen/vs_8" />

    <!-- ================= 频道墙 ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10mm"
        android:layout_weight="1">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mChannelGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/h_edge"
            android:paddingTop="@dimen/vs_10"
            android:paddingEnd="@dimen/h_edge"
            android:paddingBottom="@dimen/vs_30"
            app:tv_horizontalSpacingWithMargins="@dimen/v8_live_card_gap"
            app:tv_verticalSpacingWithMargins="@dimen/v8_live_card_gap" />

        <!-- 空态：没频道 / 只有自定义直播源占位 / 读取失败，都停在这里说清楚 -->
        <LinearLayout
            android:id="@+id/liveEmptyBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/h_edge"
            android:paddingEnd="@dimen/h_edge"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="@dimen/v8_live_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10mm"
                android:gravity="center"
                android:lineSpacingExtra="4mm"
                android:textColor="#99FFFFFF"
                android:textSize="@dimen/v8_flt_group_name" />

            <TextView
                android:id="@+id/btnEmptyAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18mm"
                android:background="@drawable/v8_btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/v8_btn_pad"
                android:paddingTop="6mm"
                android:paddingEnd="@dimen/v8_btn_pad"
                android:paddingBottom="6mm"
                android:textColor="@color/v8_btn_ghost_tx"
                android:textSize="@dimen/v8_btn_tx" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
