<?xml version="1.0" encoding="utf-8"?>
<!-- 首页行内海报卡。片名放在海报外面（设计稿 v8），
     所以整卡 = 海报 + 一行标题，焦点环只包海报，标题靠变白提示。
     id 与 GridAdapter 用的那套一致，方便两处复用同一份绑定逻辑。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/v8_card_w"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="@dimen/v8_card_w"
        android:layout_height="@dimen/v8_card_h">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/PosterRound" />

        <!-- 焦点白环，默认隐藏 -->
        <View
            android:id="@+id/vRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/v8_poster_ring"
            android:visibility="gone" />

        <!-- 左上角标：评分 / 备注，没有就不显示（不留空框） -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/v8_card_badge"
            android:layout_marginTop="@dimen/v8_card_badge"
            android:background="@drawable/shape_badge_small"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxWidth="@dimen/v8_card_w"
            android:paddingLeft="4mm"
            android:paddingTop="1.2mm"
            android:paddingRight="4mm"
            android:paddingBottom="1.2mm"
            android:singleLine="true"
            android:textColor="#F2FFFFFF"
            android:textSize="@dimen/ts_16"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/v8_card_name_mt"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#A6FFFFFF"
        android:textSize="@dimen/v8_card_name" />

</LinearLayout>
