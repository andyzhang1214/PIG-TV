<?xml version="1.0" encoding="utf-8"?>
<!-- 首页顶部的「观看历史」海报墙：标题 + 固定 1 行高的网格。
     高度写死 v8_wall_h（1 行卡高），不用 wrap_content —— 网格行数变了会让首屏高度跳动。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/h_edge"
        android:layout_marginBottom="@dimen/v8_line_head_mb"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvLineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#F2FFFFFF"
            android:textSize="@dimen/v8_line_head"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLineSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7.6mm"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#66FFFFFF"
            android:textSize="@dimen/ts_14" />

    </LinearLayout>

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/rvLine"
        android:layout_width="match_parent"
        android:layout_height="@dimen/v8_wall_h"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/h_edge"
        android:paddingEnd="@dimen/v8_line_pad_end"
        app:tv_selectedItemIsCentered="false" />

</LinearLayout>
