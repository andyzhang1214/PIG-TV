<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main"
        android:orientation="horizontal"
        android:padding="@dimen/vs_30">

        <!-- 白底 + 内边距 = 二维码静区，扫起来更稳 -->
        <ImageView
            android:id="@+id/ivQRCode"
            android:layout_width="@dimen/vs_280"
            android:layout_height="@dimen/vs_280"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_qr_white"
            android:focusable="false"
            android:padding="@dimen/vs_10"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="@dimen/vs_720"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_25"
            android:orientation="vertical">

            <!-- 扫码地址：告诉用户手机打开哪个网址，不必再猜 -->
            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_15"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:shadowColor="@color/color_000000_60"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="5"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_22"
                android:textStyle="bold"
                tools:text="手机扫码或浏览器打开 http://192.168.1.10:9978" />

            <!-- 推荐源：点播接口一键填入，省掉手打长地址。
                 文案由 ApiDialog 按数组刷，不写死在这里。 -->
            <LinearLayout
                android:id="@+id/llQuick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_15"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vs_8"
                    android:layout_marginRight="@dimen/vs_8"
                    android:text="推荐"
                    android:textColor="@color/color_FFFFFF_50"
                    android:textSize="@dimen/ts_18" />

                <TextView
                    android:id="@+id/quickSrc0"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/vs_45"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_marginRight="@dimen/vs_5"
                    android:layout_weight="1"
                    android:background="@drawable/shape_setting_model_focus"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_18"
                    tools:text="盒子迷·饭太硬" />

                <TextView
                    android:id="@+id/quickSrc1"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/vs_45"
                    android:layout_marginEnd="@dimen/vs_5"
                    android:layout_marginRight="@dimen/vs_5"
                    android:layout_weight="1"
                    android:background="@drawable/shape_setting_model_focus"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_18"
                    tools:text="liucn 综合" />

                <TextView
                    android:id="@+id/quickSrc2"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/vs_45"
                    android:layout_weight="1"
                    android:background="@drawable/shape_setting_model_focus"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center"
                    android:singleLine="true"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_18"
                    tools:text="盒子迷·禁止贩卖" />
            </LinearLayout>

            <!-- ============ 点播 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_4"
                android:text="点播接口"
                android:textColor="@color/color_FFFFFF_50"
                android:textSize="@dimen/ts_18" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_80"
                    android:layout_height="wrap_content"
                    android:text="名称"
                    android:textColor="@color/color_FFFFFF_50"
                    android:textSize="@dimen/ts_18" />

                <EditText
                    android:id="@+id/input_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/input_dialog_api_input"
                    android:hint="可留空，默认显示接口名"
                    android:inputType="text"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:minHeight="@dimen/vs_45"
                    android:paddingLeft="@dimen/vs_12"
                    android:paddingTop="@dimen/vs_8"
                    android:paddingRight="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_8"
                    android:textColor="@color/color_FFFFFF"
                    android:textColorHint="@color/color_FFFFFF_50"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_80"
                    android:layout_height="wrap_content"
                    android:text="地址"
                    android:textColor="@color/color_FFFFFF_50"
                    android:textSize="@dimen/ts_18" />

                <EditText
                    android:id="@+id/input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/input_dialog_api_input"
                    android:hint="点播接口地址"
                    android:inputType="text"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:minHeight="@dimen/vs_45"
                    android:paddingLeft="@dimen/vs_12"
                    android:paddingTop="@dimen/vs_8"
                    android:paddingRight="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_8"
                    android:shadowColor="@color/color_000000_60"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:textColor="@color/color_FFFFFF"
                    android:textColorHint="@color/color_FFFFFF_50"
                    android:textSize="@dimen/ts_20" />

                <LinearLayout
                    android:id="@+id/apiHistory"
                    android:layout_width="@dimen/vs_60"
                    android:layout_height="@dimen/vs_45"
                    android:layout_marginStart="@dimen/vs_6"
                    android:layout_marginLeft="@dimen/vs_6"
                    android:background="@drawable/shape_setting_model_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/vs_25"
                        android:layout_height="@dimen/vs_25"
                        android:focusable="false"
                        android:src="@drawable/hm_history" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 直播 ============ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_4"
                android:text="直播接口"
                android:textColor="@color/color_FFFFFF_50"
                android:textSize="@dimen/ts_18" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_80"
                    android:layout_height="wrap_content"
                    android:text="名称"
                    android:textColor="@color/color_FFFFFF_50"
                    android:textSize="@dimen/ts_18" />

                <EditText
                    android:id="@+id/input_live_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/input_dialog_api_input"
                    android:hint="可留空"
                    android:inputType="text"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:minHeight="@dimen/vs_45"
                    android:paddingLeft="@dimen/vs_12"
                    android:paddingTop="@dimen/vs_8"
                    android:paddingRight="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_8"
                    android:textColor="@color/color_FFFFFF"
                    android:textColorHint="@color/color_FFFFFF_50"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/vs_6"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_80"
                    android:layout_height="wrap_content"
                    android:text="地址"
                    android:textColor="@color/color_FFFFFF_50"
                    android:textSize="@dimen/ts_18" />

                <EditText
                    android:id="@+id/input_live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/input_dialog_api_input"
                    android:hint="直播源地址，留空用内置"
                    android:inputType="text"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:minHeight="@dimen/vs_45"
                    android:paddingLeft="@dimen/vs_12"
                    android:paddingTop="@dimen/vs_8"
                    android:paddingRight="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_8"
                    android:shadowColor="@color/color_000000_60"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="3"
                    android:textColor="@color/color_FFFFFF"
                    android:textColorHint="@color/color_FFFFFF_50"
                    android:textSize="@dimen/ts_20" />

                <LinearLayout
                    android:id="@+id/liveHistory"
                    android:layout_width="@dimen/vs_60"
                    android:layout_height="@dimen/vs_45"
                    android:layout_marginStart="@dimen/vs_6"
                    android:layout_marginLeft="@dimen/vs_6"
                    android:background="@drawable/shape_setting_model_focus"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/vs_25"
                        android:layout_height="@dimen/vs_25"
                        android:focusable="false"
                        android:src="@drawable/hm_history" />
                </LinearLayout>
            </LinearLayout>

            <!-- EPG 属于直播节目单，跟直播放一起；默认值直接摆在框里，不用猜 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_6"
                android:layout_marginBottom="@dimen/vs_4"
                android:text="节目单 · 默认值"
                android:textColor="@color/color_FFFFFF_50"
                android:textSize="@dimen/ts_18" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/vs_80"
                    android:layout_height="wrap_content"
                    android:text="地址"
                    android:textColor="@color/color_FFFFFF_50"
                    android:textSize="@dimen/ts_18" />

                <EditText
                    android:id="@+id/input_epg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/input_dialog_api_input"
                    android:hint="留空用默认值"
                    android:inputType="text"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:minHeight="@dimen/vs_45"
                    android:paddingLeft="@dimen/vs_12"
                    android:paddingTop="@dimen/vs_8"
                    android:paddingRight="@dimen/vs_8"
                    android:paddingBottom="@dimen/vs_8"
                    android:textColor="@color/color_FFFFFF"
                    android:textColorHint="@color/color_FFFFFF_50"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

            <!-- ============ 底栏 ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_15"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/storagePermission"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/vs_10"
                    android:text="存储权限"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/inputSubmit"
                    android:layout_width="@dimen/vs_140"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:background="@drawable/button_dialog_main"
                    android:focusable="true"
                    android:gravity="center"
                    android:padding="@dimen/vs_10"
                    android:text="保存并生效"
                    android:textColor="@color/color_FFFFFF"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
