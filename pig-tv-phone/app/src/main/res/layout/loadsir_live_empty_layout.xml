<?xml version="1.0" encoding="utf-8"?>
<!--
    直播页「暂无频道 / 加载超时」状态页。

    以前手机版这里是一条 Toast 加 finish()：用户点「直播」转一圈就被弹回首页，
    完全不知道发生了什么。而如果直播源请求挂住，转圈根本不会结束——因为
    以前只有 showLoading()，没有任何兜底。

    现在停在本页：把原因写清楚，整屏可点重试，按返回键直接退出（手机上不再要求双击）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lvEmptyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0A0C"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/vs_30"
        android:paddingEnd="@dimen/vs_30">

        <!-- 小标签：和首页 hero 上那排 kicker 同一套语言 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="0.22"
            android:text="LIVE"
            android:textColor="#8CFFFFFF"
            android:textSize="@dimen/ts_12" />

        <TextView
            android:id="@+id/lvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_12"
            android:includeFontPadding="false"
            android:text="直播频道还没准备好"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/ts_22"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lvEmptySub"
            android:layout_width="@dimen/vs_300"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:text="当前接口没有返回任何直播频道"
            android:textColor="#B3FFFFFF"
            android:textSize="@dimen/ts_14" />

        <View
            android:layout_width="@dimen/vs_45"
            android:layout_height="1mm"
            android:layout_marginTop="@dimen/vs_25"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/lvEmptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_15"
            android:includeFontPadding="false"
            android:text="点屏幕重新加载　·　按返回键退出"
            android:textColor="#8CFFFFFF"
            android:textSize="@dimen/ts_12" />
    </LinearLayout>

</FrameLayout>
