<?xml version="1.0" encoding="utf-8"?>
<!--
    推荐直播源弹窗。

    宽度沿用添加弹窗的 720mm —— 一行说明文字动辄四五十个字，窄了就得折三行，
    三行一折，三条源就撑满一屏。列表高度写死而不是 wrap_content：
    以后预设加到五六条时，弹窗不会被顶到屏幕外，列表自己滚。

    没有「确定」按钮：选中一条就是添加并切换，多一次确认对遥控器来说是纯负担
    （源不对的话回源管理页点一下「内置频道表」就回来了，成本一样低）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/v8_src_dlg_w"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/v8_dialog_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/v8_src_dlg_pad"
        android:paddingTop="@dimen/v8_src_dlg_pad"
        android:paddingEnd="@dimen/v8_src_dlg_pad"
        android:paddingBottom="@dimen/v8_src_dlg_pad">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/v8_src_preset_title"
            android:textColor="?attr/uiText"
            android:textSize="@dimen/v8_src_dlg_tx"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/v8_src_sub_mt"
            android:lineSpacingExtra="3mm"
            android:text="@string/v8_src_preset_desc"
            android:textColor="?attr/uiTextSub"
            android:textSize="@dimen/v8_src_dlg_hint_tx" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mPresetList"
            android:layout_width="match_parent"
            android:layout_height="@dimen/v8_preset_list_h"
            android:layout_marginTop="12mm"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="@dimen/vs_5"
            android:paddingBottom="@dimen/vs_5"
            app:tv_layoutManager="V7LinearLayoutManager"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/v8_src_row_gap" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14mm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:text="@string/v8_src_preset_hint"
                android:textColor="?attr/uiTextDim"
                android:textSize="@dimen/v8_src_dlg_hint_tx" />

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/v8_btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/v8_btn_pad"
                android:paddingTop="6mm"
                android:paddingEnd="@dimen/v8_btn_pad"
                android:paddingBottom="6mm"
                android:text="@string/v8_src_dlg_cancel"
                android:textColor="@color/v8_btn_ghost_tx"
                android:textSize="@dimen/v8_btn_tx" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
