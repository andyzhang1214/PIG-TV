<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10mm"
    android:layout_marginBottom="10mm"
    android:background="@drawable/shape_live_focus"
    android:layout_marginLeft="10mm"
    android:layout_marginRight="10mm"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvChannelNum"
        android:layout_width="60mm"
        android:layout_height="35mm"
        android:layout_marginStart="@dimen/vs_10"
        android:layout_marginLeft="@dimen/vs_10"
        android:layout_marginEnd="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_10"
        android:background="@drawable/channel_num_bg"
        android:ellipsize="marquee"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="24mm"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvChannelName"
        android:layout_width="0mm"
        android:layout_height="60mm"
        android:layout_marginStart="@dimen/vs_10"
        android:layout_marginLeft="@dimen/vs_10"
        android:layout_marginEnd="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_10"
        android:layout_weight="1"
        android:ellipsize="marquee"
        android:gravity="left|center_vertical"
        android:marqueeRepeatLimit="marquee_forever"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="2"
        android:singleLine="true"
        android:textColor="@android:color/white"
        android:textSize="22mm" />

    <!-- 已收藏的台在名字后面挂一颗金星。播放页侧栏不跟界面明暗走（永远深底），
         所以这里不需要任何底盘，纯星就够。用的是和频道墙同一张 ic_fav_star，
         两处星形必须一模一样，否则用户会以为是两种状态。 -->
    <ImageView
        android:id="@+id/tvFav"
        android:layout_width="@dimen/v8_live_fav_icon_side"
        android:layout_height="@dimen/v8_live_fav_icon_side"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/vs_10"
        android:layout_marginRight="@dimen/vs_10"
        android:contentDescription="@string/v8_fav_current"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_fav_star"
        android:visibility="gone" />
</LinearLayout>