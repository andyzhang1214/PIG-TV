<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页切换面板里的一行频道。

    一行四样东西，从左到右：
      · 台标白牌（28mm 见方）—— 台标图大小不一，白牌把它们统一成同宽的锚点；
      · 台名 + 「N 条线路」副标题；
      · 收藏星（追台时在几百行里靠它认，没有就整块不显示）；
      · 红色「直播」徽标 —— **只在正在播的那一行**出现，回答「现在放的是哪个」。

    为什么不再显示频道号：号码牌占了行首 60mm，而遥控器上并没有「按号跳台」
    这条路径（数字键只在面板收起时才生效）。花掉六分之一的宽度放一个用不上的数字，
    台名就得砍到四五个字，认台反而更慢。

    台标没到手时在白牌里写台名（深色字），而不是留一块空白牌：
    播放页是「正在看」的地方，认不出这一行是哪个台比样式统一重要得多。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/v8_live_row_h"
    android:background="@drawable/bg_live_row"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/v8_live_row_pad"
    android:paddingEnd="@dimen/v8_live_row_pad">

    <FrameLayout
        android:layout_width="@dimen/v8_live_logo_box"
        android:layout_height="@dimen/v8_live_logo_box"
        android:background="@drawable/bg_live_logo_tile"
        android:padding="@dimen/v8_live_logo_pad">

        <ImageView
            android:id="@+id/tvRowLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvRowLogoName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#1A1C22"
            android:textSize="@dimen/v8_live_tile_tx"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/v8_live_row_pad"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/v8_live_row_tx"
            android:textSize="@dimen/v8_live_row_name_tx" />

        <TextView
            android:id="@+id/tvRowSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.5mm"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/v8_live_row_sub"
            android:textSize="@dimen/v8_live_row_sub_tx" />

    </LinearLayout>

    <ImageView
        android:id="@+id/tvRowFav"
        android:layout_width="@dimen/v8_live_grp_num_tx"
        android:layout_height="@dimen/v8_live_grp_num_tx"
        android:layout_marginStart="4mm"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_fav_star"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvRowLive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5mm"
        android:background="@drawable/bg_live_badge_live"
        android:includeFontPadding="false"
        android:paddingStart="3mm"
        android:paddingTop="1.4mm"
        android:paddingEnd="3mm"
        android:paddingBottom="1.4mm"
        android:text="@string/v8_live_row_live"
        android:textColor="@android:color/white"
        android:textSize="@dimen/v8_live_badge_tx"
        android:visibility="gone" />

</LinearLayout>
