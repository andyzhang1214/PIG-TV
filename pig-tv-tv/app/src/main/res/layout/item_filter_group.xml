<?xml version="1.0" encoding="utf-8"?>
<!-- 筛选弹层里的一行：左边组名（年份/地区/类型…），右边一排可左右滑的胶囊。
     用横向 TvRecyclerView 而不是 FlowLayout：D-pad 在 RV 里左右走最稳，
     走到行尾再按右不会乱跳到隔壁组，走到头按上/下才换组。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/v8_flt_row_gap"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvFilterGroup"
        android:layout_width="@dimen/v8_flt_group_w"
        android:layout_height="@dimen/v8_flt_pill_h"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#8CFFFFFF"
        android:textSize="@dimen/v8_flt_group_name" />

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/rvFilterVals"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:tv_horizontalSpacingWithMargins="6mm"
        app:tv_selectedItemIsCentered="false" />

</LinearLayout>
