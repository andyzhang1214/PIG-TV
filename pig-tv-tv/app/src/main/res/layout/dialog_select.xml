<?xml version="1.0" encoding="utf-8"?>
<!--
    SelectDialog 底板（换片源、筛选值等共用）
    v8：深色玻璃 + 大圆角；标题左对齐；底部固定一行按键提示。
    数据、回调、选中逻辑都不动，只换皮。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_root"
        android:layout_width="@dimen/vs_480"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/vs_30"
        android:background="@drawable/v8_dialog_bg"
        android:paddingLeft="@dimen/vs_40"
        android:paddingTop="@dimen/vs_30"
        android:paddingRight="@dimen/vs_40"
        android:paddingBottom="@dimen/vs_25">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/ts_24"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="切换片源" />

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_25"
            android:orientation="vertical"
            app:layout_constrainedHeight="true"
            app:layout_constraintHeight_max="@dimen/vs_340"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
            app:tv_layoutManager="V7LinearLayoutManager"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_10" />

        <!--
            底部一行：左「按键提示」+ 右「重新检测」。
            必须装在一个横向 LinearLayout 里，不能把提示的上下约束直接挂到按钮上 ——
            按钮默认 GONE 时在 ConstraintLayout 里会塌成 0×0 的点，
            提示被 top/bottom 同时约束到那个点上，高度和位置都会跟着变，
            结果「换片源 / 选清晰度」这些没接体检的弹窗提示行全跑位。
        -->
        <LinearLayout
            android:id="@+id/dlgFoot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_25"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/list">

            <TextView
                android:id="@+id/dlgHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/v8_dlg_hint"
                android:textColor="#4DFFFFFF"
                android:textSize="@dimen/ts_18" />

            <!-- 站点体检专用：只有接入了体检的弹窗才显示，其它弹窗保持 GONE（不占位） -->
            <TextView
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vs_20"
                android:background="@drawable/v8_btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/vs_25"
                android:paddingTop="@dimen/vs_10"
                android:paddingEnd="@dimen/vs_25"
                android:paddingBottom="@dimen/vs_10"
                android:text="@string/v8_probe_refresh"
                android:textColor="@color/v8_dialog_item_tx"
                android:textSize="@dimen/ts_16"
                android:visibility="gone" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
