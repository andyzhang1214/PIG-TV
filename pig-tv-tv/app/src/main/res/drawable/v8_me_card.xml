<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页「我的」卡面。
     为什么不用 v8_vip_card：那张卡是给会员中心左栏（屏宽 43%）设计的，
     45° 斜向渐变放在这里铺满整行（842px）之后被横向拉长，
     右半边直接黑掉，左边亮右边死黑 —— 一条渐变带看着很脏。
     这里改成 0°（纯横向）从左暖到右暗，超宽比例下过渡才均匀。
     颜色仍与 v8_vip_card 同一族（#3A2318 → #160F14），两处卡不会像两个 App。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#FF3E2619"
        android:centerColor="#FF26191E"
        android:endColor="#FF171016"
        android:type="linear" />
    <stroke android:width="0.8mm" android:color="#33FFCE98" />
    <corners android:radius="@dimen/v8_vip_radius" />
</shape>
