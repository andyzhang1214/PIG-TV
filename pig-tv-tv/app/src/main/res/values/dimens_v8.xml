    <dimen name="v8_chip_h">19mm</dimen>
    <dimen name="v8_chip_pad">11mm</dimen>
    <dimen name="v8_chip_tx">9.5mm</dimen>
    <dimen name="v8_cat_title">16.5mm</dimen>
    <dimen name="v8_grid_w">132mm</dimen>
    <dimen name="v8_grid_h">198mm</dimen>

    <!-- ============ 首页顶部：推荐大卡行 ============ -->
    <!-- 首页只有「推荐」一块，卡片做大到把首屏填满，横向可滑看全部：
         卡宽 215mm + 间距 12mm，一屏正好 5 张；卡高 322mm 是 2:3，海报不裁。
         改宽度要同步 v8_wall_h（卡高 + 片名行）。 -->
    <dimen name="v8_wall_h">358mm</dimen>
    <dimen name="v8_wall_card_w">215mm</dimen>
    <dimen name="v8_wall_card_h">322mm</dimen>
    <dimen name="v8_wall_gap">12mm</dimen>
    <dimen name="v8_wall_name">16mm</dimen>
    <dimen name="v8_wall_name_mt">4.6mm</dimen>
    <dimen name="v8_wall_sub">12.5mm</dimen>


</resources>
