<?xml version="1.0" encoding="utf-8"?>
<!-- 分类页 / 推荐页封面墙的一格（v11）
     对齐设计稿 .grid .card：海报在上、片名在下（.cap 在 pic 外面）。
     焦点加白环 + 轻微放大（1.06，动效由 GridAdapter 统一处理）。

     图上只留一样东西 —— 左下角那行信息（tvFoot），内容和手机端 .pcB 完全一致：
     有「更新至 12 集 / 评分 7.5」这类备注就显示备注，没有就「类型 · 年份 · 地区」。
     原来压在图上的年份角标和右上角备注都撤了：同一条信息出现两遍只是噪音。

     注意：GridAdapter.applyStyleToImage() 会按 style 比例重设
     ivThumb「父容器」的宽高，所以 ivThumb 的直接父级必须是一个
     只包海报的容器，不能再把片名塞进这个容器里。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/v8_grid_ring"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/vs_2">

    <!-- 海报本体 -->
    <FrameLayout
        android:layout_width="@dimen/v8_wall_card_w"
        android:layout_height="@dimen/v8_wall_card_h"
        android:layout_marginStart="2.6mm"
        android:layout_marginTop="2.6mm"
        android:layout_marginEnd="2.6mm">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/PosterRound" />

        <!-- 底部渐隐：给左下角那行字垫底，浅色海报上也读得清。
             高度写死 130mm（卡高的 40%）：百分比布局在部分定制盒子上算成 0，
             一失效就是白字直接糊在亮海报上，看不清。 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="130mm"
            android:layout_gravity="bottom"
            android:background="@drawable/v8_card_scrim" />

        <!-- 左下角：更新备注 / 类型 · 年份 · 地区（手机端同款） -->
        <TextView
            android:id="@+id/tvFoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/vs_8"
            android:layout_marginEnd="@dimen/vs_8"
            android:layout_marginBottom="@dimen/vs_6"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:singleLine="true"
            android:textColor="#F2FFFFFF"
            android:textSize="@dimen/v8_wall_sub" />

        <!-- 焦点白环：影视页没有 hero 了，焦点在哪一格全靠这一圈白线。
             必须盖在图上（画在 ivThumb 之后），用 root 的 background 是画在
             图片底下的，一点都看不见。 -->
        <View
            android:id="@+id/vRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/v8_poster_ring"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/delFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@drawable/shape_user_delete"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="@dimen/vs_80"
                android:layout_height="@dimen/vs_80"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/vs_20"
                android:src="@drawable/icon_delete" />
        </FrameLayout>

    </FrameLayout>

    <!-- 片名（设计稿 .cap 在 pic 下面，不在海报里压字） -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="@dimen/v8_wall_card_w"
        android:layout_height="wrap_content"
        android:layout_marginStart="2.6mm"
        android:layout_marginTop="@dimen/v8_wall_name_mt"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text="Title"
        android:textColor="@color/v8_grid_name"
        android:textSize="@dimen/v8_wall_name" />

    <!-- 演员：默认隐藏，保持 id 存在 -->
    <TextView
        android:id="@+id/tvActor"
        android:layout_width="@dimen/v8_wall_card_w"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="#8CFFFFFF"
        android:textSize="@dimen/ts_12"
        android:visibility="gone" />

</LinearLayout>
