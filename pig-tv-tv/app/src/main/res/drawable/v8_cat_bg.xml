<?xml version="1.0" encoding="utf-8"?>
<!-- 分类页 / 配置中心的左列项：
     焦点 = 稍亮底 + 左侧白竖条；选中（当前所在分类/分组）= 淡底 + 半亮竖条。
     离开焦点以后还得知道自己在哪一页，所以选中态必须单独一层。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1FFFFFFF" />
                    <corners android:radius="4mm" />
                </shape>
            </item>
            <item android:width="1.6mm" android:gravity="start|center_vertical">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFFFF" />
                    <corners android:radius="0.8mm" />
                    <size android:height="14mm" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#12FFFFFF" />
                    <corners android:radius="4mm" />
                </shape>
            </item>
            <item android:width="1.6mm" android:gravity="start|center_vertical">
                <shape android:shape="rectangle">
                    <solid android:color="#66FFFFFF" />
                    <corners android:radius="0.8mm" />
                    <size android:height="14mm" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="4mm" />
        </shape>
    </item>
</selector>
